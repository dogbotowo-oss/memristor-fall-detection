&CONTROL
 calculation='relax'
 prefix='nfo_p1nat'
 outdir='./tmp'
 pseudo_dir='./pseudo'
 restart_mode='from_scratch'
 tprnfor=.true.
 tstress=.false.
 verbosity='high'
 max_seconds=200000
 forc_conv_thr=1.5d-3
/
&SYSTEM

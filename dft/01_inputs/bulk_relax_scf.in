 electron_maxstep=400
 mixing_mode='plain'
 mixing_beta=0.05
 mixing_ndim=8
 mixing_fixed_ns=8
 diagonalization='david'
 startingpot='atomic'
 startingwfc='atomic'
/

&IONS

&CONTROL
 calculation='relax'
 prefix='nfo_p1nat'
 outdir='./tmp'
 pseudo_dir='./pseudo'
 restart_mode='from_scratch'
 tprnfor=.true.
 tstress=.false.
 verbosity='high'
 disk_io='low'
 max_seconds=200000
 forc_conv_thr=1.5d-3
/
&SYSTEM
 ibrav=0
 nat=55
 ntyp=6
 ecutwfc=80.0
 ecutrho=640.0
 nspin=2
 nbnd=330
 nosym=.true.
 tot_charge=0.0
 occupations='smearing'
 smearing='gaussian'
 degauss=0.05
 starting_magnetization(1)=0.00
 starting_magnetization(2)=-0.60
 starting_magnetization(3)=0.50
 starting_magnetization(4)=0.30
 starting_magnetization(5)=0.10
 starting_magnetization(6)=0.00
/
&ELECTRONS
 conv_thr=1.0d-6
 electron_maxstep=400
 mixing_mode='plain'
 mixing_beta=0.05
 mixing_ndim=8
 mixing_fixed_ns=8
 diagonalization='david'
 startingpot='file'
 startingwfc='file'
/

&IONS
 ion_dynamics='bfgs'
 trust_radius_ini=0.05
 trust_radius_max=0.10
/

! Inverse-spinel NiFe2O4 ordered candidate; NOT the six-cation experimental film.
! REQUIRE: dos.ready
&CONTROL
 calculation='nscf'
 prefix='nfo_bulk'
 outdir='./tmp/bulk_k3_nscf'
 pseudo_dir='./pseudo'
 restart_mode='from_scratch'
 tprnfor=.true.
 disk_io='low'
 tstress=.true.
 verbosity='high'
 nstep=150
 max_seconds=165000
 forc_conv_thr=1.0d-6
 etot_conv_thr=1.0d-5
/
&SYSTEM
 ibrav=0
 nat=56
 ntyp=4
 ecutwfc=60.0
 ecutrho=480.0
 nspin=2
 nosym=.true.
 tot_charge=0.0
 starting_magnetization(1)=-0.60
 starting_magnetization(2)=0.60
 starting_magnetization(3)=0.30
 occupations='smearing'
 smearing='gaussian'
 degauss=0.02
 nbnd=300
/
&ELECTRONS
 conv_thr=1.0d-6
 electron_maxstep=400
 mixing_mode='plain'
 mixing_beta=0.05
 mixing_ndim=8
 mixing_fixed_ns=8
 diagonalization='cg'
 startingpot='file'
/

ATOMIC_SPECIES
FeA 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
FeB 55.845 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
Ni  58.693 Ni.pbe-spn-kjpaw_psl.1.0.0.UPF
O   15.999 O.pbe-n-kjpaw_psl.1.0.0.UPF

HUBBARD (ortho-atomic)
U FeA-3d 4.0
U FeB-3d 4.0
U Ni-3d 6.0


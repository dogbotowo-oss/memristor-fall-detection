&CONTROL
 calculation='relax'
 prefix='nfo_nebMD'
 outdir='./tmp'
 pseudo_dir='./pseudo'
 restart_mode='restart'
 tprnfor=.true.
 tstress=.false.
 verbosity='high'
/
&SYSTEM
